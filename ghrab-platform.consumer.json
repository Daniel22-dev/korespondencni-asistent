{
  "schema": "ghrab-platform-consumer-v1",
  "appId": "differentiator",
  "appName": "Diferenciátor",
  "appVersion": "1.3.12",
  "platform": {
    "version": "1.1.0",
    "contract": "ghrab-platform-v1",
    "requiredRange": ">=1.1.0 <2.0.0",
    "compatibilityWindow": [
      "1.1.x",
      "1.2.x"
    ]
  },
  "brand": {
    "version": "1.0.0",
    "logo": "assets/brand/school-logo.png",
    "footerContract": "ghrab-footer-v1"
  },
  "theme": {
    "supported": [
      "light",
      "dark"
    ],
    "default": "light"
  },
  "storageMigration": {
    "id": "p2-storage-namespace-v1",
    "backup": "full",
    "mappings": [
      {
        "legacy": "dpl_theme",
        "canonical": "ghrab.differentiator.theme.v1"
      },
      {
        "legacy": "dpl_cefr_language_pref",
        "canonical": "ghrab.differentiator.cefr-language.v1"
      },
      {
        "legacy": "dpl_guide_seen",
        "canonical": "ghrab.differentiator.guide-seen.v1"
      },
      {
        "legacy": "dpl_gemini_model",
        "canonical": "ghrab.differentiator.ai.model.v1"
      },
      {
        "legacy": "dpl_gemini_key",
        "canonical": "ghrab.differentiator.ai.key.local.v1"
      },
      {
        "legacy": "dpl_gemini_key_session",
        "canonical": "ghrab.differentiator.ai.key.session.v1",
        "store": "session"
      },
      {
        "legacyPrefix": "dpl_",
        "canonicalPrefix": "ghrab.differentiator.legacy."
      }
    ]
  },
  "bridge": {
    "contract": "ghrab-studio-handoff-v2",
    "acceptsLegacy": "ghrab-handoff-v1",
    "maxBytes": 500000
  },
  "artifact": {
    "schema": "ghrab-artifact-envelope-v1",
    "checksum": "SHA-256",
    "exports": [
      "differentiator-project"
    ],
    "imports": [
      "differentiator-project"
    ],
    "acceptsLegacyJson": true,
    "nativeFormats": [
      "docx",
      "html",
      "txt"
    ]
  },
  "cache": {
    "name": "ghrab-differentiator-v1.3.12",
    "updateMessage": "GHRAB_SKIP_WAITING"
  },
  "html": {
    "exclude": [],
    "noFooter": [
      "tests/"
    ]
  },
  "quality": {
    "schema": "ghrab-quality-consumer-v1",
    "accessibilityContract": "ghrab-a11y-v1",
    "performanceContract": "ghrab-performance-v1",
    "moduleContract": "ghrab-lazy-modules-v1",
    "requireBudget": true,
    "performanceBudget": {
      "distBytes": 820000,
      "entryHtmlBytes": 330000,
      "entryCriticalBytes": 510000,
      "largestInlineScriptBytes": 240000,
      "precacheBytes": 800000,
      "largestFileBytes": 330000,
      "duplicateLargeBytes": 30000
    },
    "modules": {
      "required": []
    },
    "referenceProfile": {
      "cpuSlowdown": 4,
      "viewport": "1366x768",
      "memoryClassGb": 4,
      "viewportWidths": [
        1280,
        390,
        320
      ]
    },
    "stage": "P5",
    "a11yContract": "ghrab-a11y-v1",
    "requireRuntimeBudget": true,
    "runtimeBudget": {
      "maxDomNodes": 1000,
      "maxRenderReadyMs": 4000,
      "maxJsHeapUsedBytes": 8000000,
      "maxLayoutDurationMs": 3000,
      "maxTaskDurationMs": 4000
    },
    "finalRelease": true,
    "cleanInstallRequired": true,
    "a11yGate": "ghrab-p5-runtime-a11y-v2",
    "releaseGate": "ghrab-p5-release-v2",
    "runtimeAudit": {
      "scriptsExecuted": true,
      "transport": "local-http",
      "dialogStates": true,
      "viewports": [
        1280,
        390,
        320
      ]
    }
  },
  "performance": {
    "stage": "P5",
    "a11yGate": "ghrab-p5-accessibility-acceptance-v1",
    "releaseGate": "ghrab-p5-acceptance-v1",
    "finalRelease": false,
    "preProductionAccepted": true
  }
}
