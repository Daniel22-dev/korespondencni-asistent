{
  "schema": "ghrab-data-manifest-v1",
  "appId": "correspondence",
  "appVersion": "5.10.15",
  "manifestVersion": 3,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.correspondence.*",
        "ghrab.correspondence.ks5.*"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.correspondence.gemini_key_session",
        "ghrab.correspondence.work_session_v2"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.correspondence.gemini_key",
        "ghrab.correspondence.gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.correspondence.gemini_key",
        "ghrab.correspondence.gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-correspondence-v*",
        "correspondence*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "sessionStorage",
      "category": "ai-prompt-debug",
      "patterns": [
        "rozbor_last_prompt_debug"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true,
      "note": "Exact anonymized prompt/system debug is stored only outside strict/sensitive scenarios; capped and cleared by end-work."
    },
    {
      "kind": "localStorage+sessionStorage",
      "category": "studio-bridge",
      "patterns": [
        "ghrab.handoff.v1",
        "ghrab.pilot.events.v2"
      ],
      "sensitivity": "potentially-personal",
      "authority": "shared-platform-client",
      "clearOnEndWork": true
    }
  ],
  "retention": {
    "automaticExpiryImplemented": false,
    "defaultDays": null,
    "sessionEndsOnLogout": false,
    "serverLogsDays": null
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [
      "correspondence-settings",
      "correspondence-library"
    ],
    "nativeFormats": [
      "docx",
      "html",
      "txt"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "serverEndpoint": null,
    "serverDeleteConnected": false
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "GHRABCorrespondencePrivacy.endWork()"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.correspondence.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "correspondence-settings",
      "correspondence-library"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  },
  "dataFlows": [
    {
      "id": "ai-egress",
      "path": "callGemini -> GHRAB_AI.generate -> fetch",
      "content": "anonymized prompt + system instructions + output schema",
      "preflightRequired": true
    },
    {
      "id": "error-reporter-fetch-wrapper",
      "path": "window.fetch wrapper in access/error-reporter.js",
      "observes": [
        "method",
        "origin+path",
        "status",
        "duration",
        "sanitized error/stack"
      ],
      "doesNotRecord": [
        "request body",
        "request headers",
        "query string",
        "API key"
      ]
    },
    {
      "id": "studio-bridge",
      "path": "ghrab.handoff.v1 / ghrab.pilot.events.v2",
      "storage": "localStorage/sessionStorage",
      "clearOnEndWork": true
    },
    {
      "id": "prompt-debug",
      "path": "rozbor_last_prompt_debug",
      "storage": "sessionStorage",
      "maxPromptChars": 30000,
      "maxSystemChars": 12000,
      "disabledForStrictSensitiveScenarios": true,
      "clearOnEndWork": true
    }
  ]
}
